{
  "name": "bugtracker/bugtracker",
  "description": "BugTracker – Hệ Thống Quản Lý Lỗi Làm Việc Nhóm",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.0",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
