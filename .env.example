# .env.example
# ============================================================
# BugTracker – Environment Configuration Template
# ============================================================
# HƯỚNG DẪN:
#   1. Copy file này thành .env ở cùng thư mục gốc
#   2. Điền đầy đủ giá trị thật vào .env
#   3. KHÔNG BAO GIỜ commit file .env lên Git
#   4. File này (.env.example) được commit để team biết
#      cần những biến gì — nhưng không chứa giá trị thật
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="BugTracker"
APP_ENV="local"                      # local | production
APP_DEBUG="true"                     # true | false — false trên production
APP_URL="http://localhost"           # Không có dấu / cuối
APP_KEY="change-this-to-random-32-char-string"  # Dùng để sign misc tokens


# ------------------------------------------------------------
# DATABASE — InfinityFree MySQL
# ------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="bugtracker_db"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"


# ------------------------------------------------------------
# SMTP — Gmail App Password (khuyến nghị cho InfinityFree)
# Xem hướng dẫn tạo App Password:
# https://support.google.com/accounts/answer/185833
# ------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"                      # TLS port — dùng 465 nếu muốn SSL
SMTP_ENCRYPTION="tls"               # tls | ssl
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-app-password-here"   # App Password, KHÔNG phải mật khẩu Gmail
SMTP_FROM="noreply@yourdomain.com"
SMTP_FROM_NAME="BugTracker"
SMTP_TIMEOUT="10"                    # Giây — giữ thấp để tránh treo request


# ------------------------------------------------------------
# FILE UPLOAD
# ------------------------------------------------------------
UPLOAD_MAX_SIZE="2097152"            # 2MB tính bằng bytes (2 * 1024 * 1024)
UPLOAD_MAX_FILES="5"                 # Tối đa 5 file/Issue (SRS Phần 3.3.2)
UPLOAD_ALLOWED_TYPES="jpg,jpeg,png,gif,pdf,txt,zip"


# ------------------------------------------------------------
# SESSION
# ------------------------------------------------------------
SESSION_LIFETIME="7200"              # Giây — 2 giờ (TDD Phần 4.6)
SESSION_NAME="bugtracker_session"
REMEMBER_ME_DAYS="30"               # Thời hạn cookie Remember Me


# ------------------------------------------------------------
# TOKEN TTL (Time To Live — tính bằng giây)
# ------------------------------------------------------------
TOKEN_TTL_EMAIL_VERIFY="86400"       # 24 giờ
TOKEN_TTL_PASSWORD_RESET="3600"      # 1 giờ
TOKEN_TTL_INVITATION="604800"        # 7 ngày


# ------------------------------------------------------------
# PAGINATION
# ------------------------------------------------------------
PAGINATION_PER_PAGE="20"             # Số bản ghi mặc định mỗi trang


# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL="DEBUG"                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_MAX_MONTHS="3"                   # Giữ tối đa N tháng log file